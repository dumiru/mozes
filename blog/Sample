<script>
(function(){
  var btn = document.querySelector('.menu-btn');
  var menu = document.getElementById('menu');
  btn.addEventListener('click', function(){
    var open = menu.classList.toggle('open');
    btn.setAttribute('aria-expanded', open);
  });
  menu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    });
  });

  // Typed role text
  var typed = document.getElementById('typed');
  var words = ['an entrepreneur', 'an interactive product designer', 'a media builder', 'a marketer'];
  var wi = 0, ci = 0, deleting = false;
  (function type(){
    var w = words[wi];
    ci += deleting ? -1 : 1;
    typed.textContent = w.slice(0, ci);
    var delay = deleting ? 40 : 90;
    if (!deleting && ci === w.length) { delay = 1800; deleting = true; }
    else if (deleting && ci === 0) { deleting = false; wi = (wi + 1) % words.length; delay = 400; }
    setTimeout(type, delay);
  })();

  // Scroll progress and hero parallax
  var bar = document.getElementById('progress');
  var heroCopy = document.querySelector('.hero .wrap > div:first-child');
  function onScroll(){
    var h = document.documentElement;
    bar.style.width = (h.scrollTop / ((h.scrollHeight - h.clientHeight) || 1) * 100) + '%';
    if (heroCopy && window.scrollY < 800) heroCopy.style.transform = 'translateY(' + (window.scrollY * 0.12) + 'px)';
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scroll reveals with alternating directions
  var revealSel = '.section-head,.card,.chip,.timeline li,.numbers,.gallery .placeholder,.work-card,.embed,.press-logos div,.partners div,.faq details,.grid-3>*,.grid-2>*,.about-grid>div,.contact-row>*,.foot-grid>div';
  var variants = ['rv-up', 'rv-left', 'rv-right', 'rv-zoom'];
  var seen = new Set();
  document.querySelectorAll(revealSel).forEach(function(el){
    if (seen.has(el) || el.closest('.hero')) return;
    seen.add(el);
    var idx = Array.prototype.indexOf.call(el.parentElement.children, el);
    el.classList.add('rv', variants[idx % 4]);
    el.style.setProperty('--d', (idx % 4) * 0.08 + 's');
  });

  function countUp(){
    var targets = [12, 5, 30, 48];
    document.querySelectorAll('.numbers strong').forEach(function(s, i){
      var start = null;
      function step(ts){
        if (!start) start = ts;
        var p = Math.min((ts - start) / 1400, 1);
        s.textContent = Math.round(targets[i] * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      if (e.target.classList.contains('numbers')) countUp();
      io.unobserve(e.target);
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.rv, .timeline, .section-head').forEach(function(el){ io.observe(el); });

  // Pointer effects (desktop only)
  if (window.matchMedia('(pointer:fine)').matches) {
    var glow = document.getElementById('glow');
    document.addEventListener('mousemove', function(e){
      glow.style.left = e.clientX + 'px';
      glow.style.top = e.clientY + 'px';
      glow.style.opacity = 1;
    });
    document.querySelectorAll('.company, .post, .quote, .work-card .placeholder').forEach(function(c){
      c.addEventListener('mousemove', function(e){
        var r = c.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - 0.5;
        var y = (e.clientY - r.top) / r.height - 0.5;
        c.style.transition = 'transform .15s ease-out';
        c.style.transform = 'perspective(900px) rotateX(' + (-y * 6) + 'deg) rotateY(' + (x * 6) + 'deg)';
      });
      c.addEventListener('mouseleave', function(){
        c.style.transition = 'transform .6s cubic-bezier(.2,.7,.2,1)';
        c.style.transform = '';
      });
    });
  }

  // Button ripple
  document.querySelectorAll('.btn').forEach(function(b){
    b.addEventListener('click', function(e){
      var r = b.getBoundingClientRect();
      var d = Math.max(r.width, r.height);
      var s = document.createElement('span');
      s.className = 'ripple';
      s.style.width = s.style.height = d + 'px';
      s.style.left = (e.clientX - r.left - d / 2) + 'px';
      s.style.top = (e.clientY - r.top - d / 2) + 'px';
      b.appendChild(s);
      setTimeout(function(){ s.remove(); }, 700);
    });
  });

  var form = document.getElementById('newsForm');
  var msg = document.getElementById('newsMsg');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var value = form.email.value.trim();
    msg.textContent = value ? 'Thanks, you are subscribed.' : 'Please enter a valid email.';
    if (value) form.reset();
    msg.classList.remove('pop');
    void msg.offsetWidth;
    msg.classList.add('pop');
  });
})();
</script>

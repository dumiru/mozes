<style>
:root{
  --orange:#E8590C;
  --orange-dark:#C2410C;
  --orange-tint:#FFF4EC;
  --ink:#1A1A1A;
  --ink-soft:#5C5752;
  --line:#EBE5DF;
  --white:#FFFFFF;
  --wrap:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:'Poppins',sans-serif;color:var(--ink);background:var(--white);font-size:16px;line-height:1.7;font-weight:300}
h1,h2,h3,h4{font-weight:500;line-height:1.25;color:var(--ink)}
h1{font-size:clamp(34px,5vw,56px);font-weight:600;letter-spacing:-.02em}
h2{font-size:clamp(24px,3vw,32px);letter-spacing:-.01em;margin-bottom:12px}
h3{font-size:18px}
p{color:var(--ink-soft)}
a{color:var(--orange);text-decoration:none}
a:hover{color:var(--orange-dark)}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--orange);outline-offset:3px;border-radius:4px}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 24px}
section{padding:88px 0;border-bottom:1px solid var(--line)}
.section-head{margin-bottom:44px;max-width:620px}
.section-head p{font-size:15px}
.btn{display:inline-block;font-family:inherit;font-size:14px;font-weight:500;padding:12px 24px;border-radius:6px;border:1px solid var(--orange);background:var(--orange);color:var(--white);cursor:pointer;transition:background .2s,color .2s}
.btn:hover{background:var(--orange-dark);border-color:var(--orange-dark);color:var(--white)}
.btn.outline{background:transparent;color:var(--orange)}
.btn.outline:hover{background:var(--orange);color:var(--white)}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
.card{border:1px solid var(--line);border-radius:8px;padding:28px;background:var(--white)}
.card p{font-size:14.5px;margin-top:8px}
.placeholder{background:var(--orange-tint);border:1px dashed #F5C7A6;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--orange-dark);font-size:13px;font-weight:400;text-align:center;padding:16px}

/* NAV */
.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{font-weight:600;color:var(--ink);font-size:16px}
.brand span{color:var(--orange)}
.nav ul{list-style:none;display:flex;gap:22px}
.nav ul a{color:var(--ink-soft);font-size:14px;font-weight:400}
.nav ul a:hover{color:var(--orange)}
.menu-btn{display:none;background:none;border:1px solid var(--line);border-radius:6px;padding:6px 12px;font-family:inherit;font-size:14px;cursor:pointer;color:var(--ink)}

/* HERO */
.hero{padding:96px 0 88px}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.hero-role{font-size:15px;color:var(--orange);font-weight:500;margin-bottom:14px}
.hero h1{margin-bottom:18px}
.tagline{font-size:18px;color:var(--ink-soft);max-width:520px;margin-bottom:32px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.hero-photo{aspect-ratio:4/5;max-width:380px;width:100%;justify-self:end}
.hero-photo .placeholder{height:100%;font-size:14px}

/* COMPANIES */
.company{display:flex;flex-direction:column;gap:6px}
.company .tag{font-size:12.5px;color:var(--orange);font-weight:500}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.about-grid p{margin-bottom:16px;font-size:15.5px}

/* EXPERTISE */
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-size:14px;color:var(--ink)}

/* JOURNEY */
.timeline{list-style:none;border-left:1px solid var(--line);margin-left:6px;max-width:680px}
.timeline li{padding:0 0 30px 28px;position:relative}
.timeline li::before{content:"";position:absolute;left:-5px;top:8px;width:9px;height:9px;border-radius:50%;background:var(--orange)}
.timeline li:last-child{padding-bottom:0}
.timeline .year{font-size:13px;color:var(--orange);font-weight:500}
.timeline h3{margin:2px 0 4px}
.timeline p{font-size:14.5px}

/* NUMBERS */
.numbers{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:8px}
.numbers div{padding:32px 24px;border-right:1px solid var(--line)}
.numbers div:last-child{border-right:none}
.numbers strong{display:block;font-size:34px;font-weight:600;color:var(--orange);line-height:1.1}
.numbers span{font-size:14px;color:var(--ink-soft)}

/* GALLERY */
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.gallery .placeholder{aspect-ratio:4/3}

/* WORK */
.work-card .placeholder{aspect-ratio:16/10;margin-bottom:18px}
.work-card h3{margin-bottom:4px}

/* CONTENT EMBEDS */
.embed{aspect-ratio:16/9;width:100%}
.embed-note{font-size:13.5px;margin-top:14px}

/* BLOG */
.post{display:flex;flex-direction:column;gap:10px}
.post .placeholder{aspect-ratio:16/10;margin-bottom:10px}
.post .meta{font-size:12.5px;color:var(--ink-soft)}
.post h3 a{color:var(--ink)}
.post h3 a:hover{color:var(--orange)}
.post p{font-size:14.5px}

/* PRESS */
.press-logos{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.press-logos div{border:1px solid var(--line);border-radius:8px;height:88px;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:14px}

/* TESTIMONIALS */
.quote p{font-size:15px;color:var(--ink);margin-bottom:18px}
.quote .who{font-size:13.5px;color:var(--ink-soft)}
.quote .who strong{color:var(--ink);font-weight:500;display:block}

/* PARTNERS */
.partners{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.partners div{height:64px;border:1px solid var(--line);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13.5px;color:var(--ink-soft)}

/* FAQ */
.faq{max-width:760px}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{cursor:pointer;font-weight:500;color:var(--ink);list-style:none;display:flex;justify-content:space-between;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--orange);font-size:20px;line-height:1}
.faq details[open] summary::after{content:"-"}
.faq details p{margin-top:12px;font-size:14.5px}

/* NEWSLETTER */
.newsletter{background:var(--orange-tint);border-radius:10px;padding:56px 48px;border:none}
.newsletter .wrap{padding:0}
.news-form{display:flex;gap:12px;max-width:520px;margin-top:24px;flex-wrap:wrap}
.news-form input{flex:1;min-width:220px;font-family:inherit;font-size:14.5px;padding:12px 16px;border:1px solid #F0CDB3;border-radius:6px;background:var(--white);color:var(--ink)}
.news-form input:focus{outline:2px solid var(--orange);outline-offset:1px;border-color:transparent}
.news-msg{font-size:13.5px;margin-top:12px;color:var(--orange-dark);min-height:20px}

/* CONTACT */
.contact-row{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
.contact-row p{font-size:15px}

/* FOOTER */
footer{padding:56px 0 32px;background:var(--ink);color:rgba(255,255,255,.7)}
.foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:32px;margin-bottom:40px}
footer h4{color:var(--white);font-size:14px;margin-bottom:12px;font-weight:500}
footer ul{list-style:none}
footer li{margin-bottom:8px}
footer a{color:rgba(255,255,255,.7);font-size:14px}
footer a:hover{color:var(--orange)}
footer .brand{color:var(--white)}
footer .foot-about{font-size:14px;max-width:340px;margin-top:10px}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:20px;font-size:13px}

/* RESPONSIVE */
@media (max-width:900px){
  .hero .wrap,.about-grid{grid-template-columns:1fr;gap:40px}
  .hero-photo{justify-self:start;max-width:300px}
  .grid-3,.gallery{grid-template-columns:1fr 1fr}
  .numbers{grid-template-columns:1fr 1fr}
  .numbers div:nth-child(2){border-right:none}
  .numbers div:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .partners{grid-template-columns:repeat(3,1fr)}
  .press-logos{grid-template-columns:1fr 1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:700px){
  section{padding:64px 0}
  .menu-btn{display:block}
  .nav ul{display:none;position:absolute;top:64px;left:0;right:0;flex-direction:column;gap:0;background:var(--white);border-bottom:1px solid var(--line);padding:8px 24px 16px}
  .nav ul.open{display:flex}
  .nav ul li{padding:10px 0;border-bottom:1px solid var(--line)}
  .grid-3,.grid-2,.gallery{grid-template-columns:1fr}
  .partners{grid-template-columns:1fr 1fr}
  .newsletter{padding:36px 24px}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}

/* ===== ANIMATION LAYER ===== */
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--orange),#FF9A4D);z-index:100}
#glow{position:fixed;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(232,89,12,.13),transparent 65%);pointer-events:none;transform:translate(-50%,-50%);z-index:0;opacity:0;transition:opacity .4s}

.hero{position:relative;overflow:hidden}
.hero .wrap{position:relative;z-index:1}
.blob{position:absolute;border-radius:50%;filter:blur(70px);pointer-events:none;z-index:0}
.b1{width:440px;height:440px;background:#FFB98A;opacity:.45;top:-140px;left:-120px;animation:drift 14s ease-in-out infinite alternate}
.b2{width:380px;height:380px;background:var(--orange);opacity:.25;bottom:-160px;right:-80px;animation:drift 18s ease-in-out infinite alternate-reverse}
@keyframes drift{from{transform:translate(0,0) scale(1)}to{transform:translate(70px,44px) scale(1.12)}}

.split > span{display:inline-block;overflow:hidden;vertical-align:bottom;padding-bottom:.1em}
.split > span > span{display:inline-block;transform:translateY(110%);animation:up 1s cubic-bezier(.2,.7,.2,1) forwards}
.split > span:nth-child(2) > span{animation-delay:.12s}
@keyframes up{to{transform:translateY(0)}}

.hero-role,.tagline,.hero-actions,.hero-photo{opacity:0;animation:fadeUp .9s cubic-bezier(.2,.7,.2,1) forwards}
.hero-role{animation-delay:.1s}
.hero-photo{animation-delay:.35s}
.tagline{animation-delay:.5s}
.hero-actions{animation-delay:.7s}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

.caret{display:inline-block;width:2px;height:1em;background:var(--orange);margin-left:3px;vertical-align:-2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

.hero-photo .placeholder{position:relative;overflow:hidden;animation:float 6s ease-in-out infinite}
.hero-photo .placeholder::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.7) 50%,transparent 70%);transform:translateX(-100%);animation:sheen 3.5s ease-in-out 1.4s infinite}
@keyframes sheen{to{transform:translateX(100%)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

.ticker{overflow:hidden;background:var(--orange);color:#fff;padding:14px 0;position:relative;z-index:2}
.ticker-track{display:flex;width:max-content;animation:marquee 26s linear infinite;font-size:14px;font-weight:500}
.ticker-track span{display:inline-flex;align-items:center;gap:16px;padding-right:48px;white-space:nowrap}
.ticker-track span::after{content:"";width:6px;height:6px;border-radius:50%;background:#fff}
@keyframes marquee{to{transform:translateX(-50%)}}

.rv{opacity:0;transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.rv-up{transform:translateY(36px)}
.rv-left{transform:translateX(-44px)}
.rv-right{transform:translateX(44px)}
.rv-zoom{transform:scale(.92)}
.rv.in{opacity:1;transform:none}

.section-head h2{display:inline-block;background:linear-gradient(var(--orange),var(--orange)) no-repeat 0 100%/0% 3px;padding-bottom:8px;transition:background-size 1s cubic-bezier(.6,0,.2,1) .3s}
.section-head.in h2{background-size:100% 3px}

.timeline{position:relative}
.timeline::before,.timeline::after{content:"";position:absolute;left:0;top:0;bottom:0;width:1px}
.timeline::before{background:var(--line)}
.timeline::after{background:var(--orange);transform:scaleY(0);transform-origin:top;transition:transform 1.8s cubic-bezier(.6,0,.2,1)}
.timeline.in::after{transform:scaleY(1)}

.numbers{transition:none}
.numbers div{transition:background .35s}
.numbers div:hover{background:var(--orange-tint)}
.numbers strong{font-variant-numeric:tabular-nums}

.gallery .placeholder{transition:transform .6s cubic-bezier(.2,.7,.2,1),box-shadow .6s;cursor:pointer;overflow:hidden}
.gallery .placeholder:hover{transform:scale(1.05);box-shadow:0 18px 40px rgba(232,89,12,.18)}

.chip{transition:background .25s,color .25s,border-color .25s,transform .25s}
.chip:hover{background:var(--orange);color:#fff;border-color:var(--orange);transform:translateY(-3px)}

.nav ul a{position:relative}
.nav ul a::after{content:"";position:absolute;left:0;bottom:-6px;height:2px;width:0;background:var(--orange);transition:width .3s}
.nav ul a:hover::after{width:100%}

.btn{position:relative;overflow:hidden}
.ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:rip .7s ease-out forwards;pointer-events:none}
@keyframes rip{to{transform:scale(3.5);opacity:0}}

.news-msg.pop{animation:pop .5s cubic-bezier(.2,.9,.3,1.3)}
@keyframes pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.card,.work-card .placeholder,.quote{will-change:transform}

@media (prefers-reduced-motion:reduce){
  .rv,.split > span > span,.hero-role,.tagline,.hero-actions,.hero-photo,.ticker-track,.blob,.caret,
  .hero-photo .placeholder,.hero-photo .placeholder::after,.timeline::after,.section-head h2{animation:none!important;transition:none!important;opacity:1!important;transform:none!important}
  .section-head.in h2{background-size:100% 3px}
  .timeline::after{transform:scaleY(1)}
  .split > span > span{transform:none!important}
  #glow{display:none}
}
</style>
</head>
